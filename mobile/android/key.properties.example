# Bu dosyayı 'key.properties' adıyla kopyala ve kendi değerlerini gir.
# key.properties .gitignore'dadır; ASLA commit etme.
#
# Keystore üretimi (bir kez):
#   keytool -genkey -v -keystore %USERPROFILE%\glow-saha-upload.jks ^
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=KEYSTORE_SIFRESI
keyPassword=ANAHTAR_SIFRESI
keyAlias=upload
storeFile=C:/Users/omerg/glow-saha-upload.jks
